# Copy to <env>.tfvars (e.g. production.tfvars) and fill in. NO SECRET VALUES here:
# secrets live in AWS Secrets Manager and are set out-of-band (see the runbook).
#   terraform plan  -var-file=production.tfvars
#   terraform apply -var-file=production.tfvars

environment = "production" # or "staging"
region      = "ap-south-1"
azs         = ["ap-south-1a", "ap-south-1b"]
vpc_cidr    = "10.20.0.0/16" # staging e.g. 10.30.0.0/16

# ---- DNS / TLS -------------------------------------------------------------
api_domain     = "api.carecompanion.example"    # staging: api.staging.carecompanion.example
portal_domains = ["portal.carecompanion.example"] # /account/delete must be served here
# ACM certificate in ap-south-1 covering both names (status ISSUED)
acm_certificate_arn = "arn:aws:acm:ap-south-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

create_route53_records = false # true if the domain's hosted zone is in this account
route53_zone_id        = ""    # e.g. Z0123456789ABCDEFGHIJ

# ---- First apply only ------------------------------------------------------
bootstrap_mode = true # set to false after the first images are in ECR

# ---- Sizing (pilot defaults) -------------------------------------------------
single_nat_gateway       = false # production: one NAT per AZ; staging: true saves ~USD 35/month
db_instance_class        = "db.t4g.medium"
db_multi_az              = true # staging: false
db_backup_retention_days = 14
db_deletion_protection   = true
redis_num_cache_clusters = 1 # 2 for automatic failover
api_min_tasks            = 2
api_max_tasks            = 6
web_min_tasks            = 1
web_max_tasks            = 3
enable_clamav            = true

# ---- App configuration ----------------------------------------------------------
# Secret NAMES Terraform creates (values set out-of-band, see the runbook). The
# defaults are exactly what NODE_ENV=production needs to boot; add optional ones
# (e.g. "FCM_PRIVATE_KEY", "JITSI_APP_SECRET") only once you have their values.
api_secret_names = [
  "DATABASE_URL",
  "JWT_SECRET",
  "PAYMENT_WEBHOOK_SECRET",
  "RAZORPAY_KEY_SECRET",
  "RAZORPAY_WEBHOOK_SECRET",
  "MSG91_AUTH_KEY",
  "MFA_ENCRYPTION_KEY",
  "VIDEO_ROOM_SECRET",
  "METRICS_TOKEN",
  "ANTHROPIC_API_KEY",
]

# Non-secret settings (services/api/src/config.ts). PAYMENT_GATEWAY=razorpay and
# SMS_PROVIDER=msg91 are set by default because production refuses mock/console.
api_extra_environment = {
  RAZORPAY_KEY_ID          = "rzp_test_xxxxxxxxxxxx" # publishable key id (staging: test mode)
  MSG91_OTP_TEMPLATE_ID    = "xxxxxxxxxxxxxxxxxxxxxxxx" # DLT-approved template (see docs/STORE_SUBMISSION.md, India notes)
  MSG91_NOTIFY_TEMPLATE_ID = "xxxxxxxxxxxxxxxxxxxxxxxx"
  MSG91_SENDER_ID          = "CARECO"
  SUPPORT_PHONE            = "+91XXXXXXXXXX"
  SUPPORT_EMAIL            = "support@carecompanion.example"
  # AI_MODEL        = "claude-opus-5"
  # FCM_PROJECT_ID  = "carecompanion-prod"
  # FCM_CLIENT_EMAIL = "firebase-adminsdk-xxx@carecompanion-prod.iam.gserviceaccount.com"
}

# ---- Alarms / CI ---------------------------------------------------------------
alarm_emails                = ["oncall@carecompanion.example"]
github_repository           = "your-org/care-companion"
create_github_oidc_provider = true # false for the 2nd environment in the same AWS account
