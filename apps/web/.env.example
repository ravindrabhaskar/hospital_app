# All NEXT_PUBLIC_* values are inlined into the bundle AT BUILD TIME and validated by src/lib/env.ts
# (next.config.ts fails the build on a malformed value). Rebuild after changing them.

# Base URL of the CareCompanion API (services/api). Must be https in production (localhost excepted).
# Its origin is also the only API origin allowed by the Content-Security-Policy.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Show the "Draft, pending legal review" banner on /privacy, /terms and /account/delete.
# Set to false only after counsel approves the texts.
NEXT_PUBLIC_LEGAL_DRAFT=true

# Jitsi host allowed in the optional embedded video frame (CSP frame-src + Permissions-Policy).
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# Fallback support contacts shown on /support while GET /config/public is unavailable (optional).
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=

# Legal placeholders used by the privacy policy / terms (founder to provide).
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=
