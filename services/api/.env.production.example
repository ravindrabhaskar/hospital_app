# CareCompanion API — PRODUCTION variables (no values). The server refuses to start when a required one is
# missing (src/config.ts: zod checks + productionReadinessIssues). REQUIRED unless marked optional.
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Core
DATABASE_URL=                     # postgres://user:pass@host:5432/carecompanion (PostgreSQL 14+)
JWT_SECRET=                       # >= 32 random chars
PAYMENT_WEBHOOK_SECRET=           # >= 16 chars (internal X-Signature webhooks)
CORS_ORIGINS=                     # https://app.example.com,https://ops.example.com
METRICS_TOKEN=                    # >= 16 chars; /metrics is 403 without it in production
REDIS_URL=                        # optional but recommended with >1 API instance (shared rate limits)

# SMS OTP (choose one provider)
SMS_PROVIDER=                     # msg91 | twilio   (console is refused)
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_NOTIFY_TEMPLATE_ID=         # optional
MSG91_SENDER_ID=                  # optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                      # or TWILIO_MESSAGING_SERVICE_SID
TWILIO_MESSAGING_SERVICE_SID=

# App-store review demo account (optional; remove after review). Exactly this phone + this OTP, no SMS.
REVIEW_PHONE=
REVIEW_OTP=

# Payments
PAYMENT_GATEWAY=razorpay          # mock is refused
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Files
STORAGE_DRIVER=s3                 # local is allowed (single instance only); memory is refused
S3_BUCKET=
S3_REGION=ap-south-1
S3_KMS_KEY_ID=                    # recommended (SSE-KMS)
S3_ENDPOINT=                      # optional (MinIO / S3-compatible)
S3_ACCESS_KEY_ID=                 # optional (prefer an IAM role)
S3_SECRET_ACCESS_KEY=             # optional
CLAMAV_HOST=                      # clamd host (no-op scanner is refused)
CLAMAV_PORT=3310

# Staff MFA
MFA_ENCRYPTION_KEY=               # openssl rand -base64 32
MFA_ENFORCED=true

# Video
VIDEO_PROVIDER=jitsi
VIDEO_ROOM_SECRET=                # >= 16 random chars
JITSI_DOMAIN=                     # optional (default meet.jit.si)
JITSI_APP_ID=                     # optional (self-hosted Jitsi with JWT auth)
JITSI_APP_SECRET=                 # optional

# Push (optional; all three together)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# AI (optional; without it the deterministic rule-based model is used)
ANTHROPIC_API_KEY=

# Public config / legal (set real values)
SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
PRIVACY_URL=
TERMS_URL=
ACCOUNT_DELETION_URL=
MIN_APP_VERSION_PATIENT_ANDROID=
MIN_APP_VERSION_PATIENT_IOS=
MIN_APP_VERSION_PROVIDER_ANDROID=
MIN_APP_VERSION_PROVIDER_IOS=

# v1.2 functional completeness
PUBLIC_API_BASE_URL=              # https://api.example.com/api/v1 (profile photo URLs are built from it; set it!)
SCHEDULE_HORIZON_DAYS=14          # optional
SELLER_LEGAL_NAME=                # legal entity printed on invoices [REQUIRES TAX REVIEW]
SELLER_GSTIN=                     # optional
SELLER_ADDRESS=                   # registered address printed on invoices
HEALTHCARE_GST_RATE=0             # [REQUIRES TAX REVIEW]
PLATFORM_FEE_PCT=20               # commercial agreement with doctors/providers
ABDM_ENABLED=false                # keep false until ABDM sandbox certification
MIN_APP_VERSION_DOCTOR_ANDROID=
MIN_APP_VERSION_DOCTOR_IOS=

# v1.3 partners. Unset = disabled in production; `mock` is refused at startup. See README "v1.3 partner credentials".
DATA_ENCRYPTION_KEY=              # 32 bytes (openssl rand -base64 32); defaults to a key derived from MFA_ENCRYPTION_KEY
WHATSAPP_PROVIDER=                # meta | disabled
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_CARE_UPDATE=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_ALERT=
WHATSAPP_TEMPLATE_LANG=en
APP_DEEP_LINK_BASE=
LAB_PARTNER=                      # http | disabled
LAB_PARTNER_NAME=
LAB_PARTNER_BASE_URL=
LAB_PARTNER_API_KEY=
LAB_WEBHOOK_SECRET=
AMBULANCE_PARTNER=                # http | disabled
AMBULANCE_PARTNER_NAME=
AMBULANCE_PARTNER_BASE_URL=
AMBULANCE_PARTNER_API_KEY=
ABDM_MODE=                        # production (after certification) | disabled
ABDM_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIU_ID=
ABDM_HIP_ID=
ABDM_CALLBACK_URL=
ABDM_WEBHOOK_SECRET=
DRUG_KNOWLEDGE_PROVIDER=          # http (licensed database) or fixture (unapproved: checks fail safe)
DRUG_KNOWLEDGE_BASE_URL=
DRUG_KNOWLEDGE_API_KEY=
STT_PROVIDER=                     # openai_whisper_compatible | google | disabled
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=
IVR_PROVIDER=                     # exotel | twilio | disabled
IVR_WEBHOOK_SECRET=
IVR_PUBLIC_URL=
SOS_BUTTON_PROVIDER=              # vendor | disabled
SOS_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=              # optional
INVITE_REWARD_INVITER=100
INVITE_REWARD_INVITEE=100
WALLET_CREDIT_EXPIRY_DAYS=365
