# CareCompanion API — copy to .env (all values optional in development)
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1
LOG_LEVEL=info

# Database: leave DATABASE_URL empty to use embedded PGlite (persisted in PGLITE_DIR).
# Set it to use real PostgreSQL, e.g. postgres://postgres:postgres@localhost:5432/carecompanion
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Auth (JWT_SECRET is REQUIRED in production; >= 32 chars)
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0123456789
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_DEV_CODE=123456
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_REQUESTS=5
OTP_WINDOW_MIN=15

# CORS: comma-separated origins. In non-production any http://localhost:* is also allowed.
CORS_ORIGINS=http://localhost:3100
RATE_LIMIT_MAX=600
RATE_LIMIT_OTP_MAX=20

# AI: without ANTHROPIC_API_KEY the deterministic RuleBasedModel is used.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN_SEC=60

# Payments (mock gateway in dev). PAYMENT_WEBHOOK_SECRET is REQUIRED in production.
PAYMENT_GATEWAY=mock
PAYMENT_WEBHOOK_SECRET=dev-only-payment-webhook-secret
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# File storage: local | memory | s3
STORAGE_DRIVER=local
STORAGE_DIR=.data/files
MAX_UPLOAD_MB=15

# Worker / SLAs
WORKER_ENABLED=true
WORKER_INTERVAL_MS=15000
FALL_RESPONSE_TIMEOUT_SEC=60
VISIT_ASSIGN_SLA_MIN=30
PAYMENT_HOLD_MIN=15
DOSE_MISSED_GRACE_MIN=60

VIDEO_BASE_URL=https://meet.carecompanion.local/room

# ---------------------------------------------------------------- v1.1 production integrations
# Everything below is optional in development (safe dev fallbacks). See README "Production configuration"
# and .env.production.example for what production requires.

# HTTP hardening / scaling
BODY_LIMIT_KB=1024              # max JSON body size (uploads use MAX_UPLOAD_MB)
REDIS_URL=                      # redis://... -> shared rate-limit counters across API instances
DATABASE_POOL_MAX=10
WORKER_LOCK_KEY=724911001       # pg_try_advisory_lock key: only the lock holder runs the worker
METRICS_TOKEN=                  # bearer token for GET /metrics (open in dev; /metrics is 403 in prod without it)

# SMS OTP: console (dev only) | msg91 | twilio
SMS_PROVIDER=console
SMS_TIMEOUT_MS=8000
MSG91_AUTH_KEY=                 # MSG91 panel -> API -> Auth key
MSG91_OTP_TEMPLATE_ID=          # MSG91 Flow template id linked to your DLT-approved OTP template (variable ##otp##)
MSG91_NOTIFY_TEMPLATE_ID=       # optional: DLT template with ##message## for outbox SMS notifications
MSG91_SENDER_ID=                # optional: DLT-registered 6-char header
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                    # sender number, or use TWILIO_MESSAGING_SERVICE_SID
TWILIO_MESSAGING_SERVICE_SID=

# App-store review demo login (optional, allowed in production): exactly this phone accepts this OTP, no SMS.
REVIEW_PHONE=
REVIEW_OTP=

# Razorpay (PAYMENT_GATEWAY=razorpay). Use rzp_test_* keys in staging.
RAZORPAY_WEBHOOK_SECRET=        # secret set on the Razorpay webhook (X-Razorpay-Signature)
PAYMENT_TIMEOUT_MS=10000

# Push: FCM HTTP v1 (all three or none; none -> console push adapter)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=               # service account client_email
FCM_PRIVATE_KEY=                # service account private_key (PEM; "
" escapes are accepted)

# S3 / MinIO (STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=                    # e.g. http://localhost:9000 for MinIO (path-style is used automatically)
S3_KMS_KEY_ID=                  # KMS key ARN/alias for SSE-KMS
S3_ACCESS_KEY_ID=               # optional: otherwise the AWS default credential chain (IAM role)
S3_SECRET_ACCESS_KEY=

# Malware scanning: ClamAV clamd (unset -> no-op scanner, refused in production)
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000

# Video: jitsi | placeholder
VIDEO_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=                   # self-hosted Jitsi token auth (JWT); leave empty for meet.jit.si
JITSI_APP_SECRET=
VIDEO_ROOM_SECRET=              # HMAC key for unguessable room names (dev derives one from JWT_SECRET)

# Staff MFA (TOTP). MFA_ENFORCED defaults to true in production, false otherwise.
MFA_ENFORCED=
MFA_ENCRYPTION_KEY=             # 32 bytes, hex (64 chars) or base64: openssl rand -base64 32
MFA_ISSUER=CareCompanion

# Account deletion / data export (DPDP)
ACCOUNT_DELETION_GRACE_DAYS=7
DATA_EXPORT_TTL_HOURS=72
DATA_EXPORT_MAX_PER_DAY=5

# Public config (GET /config/public)
SUPPORT_PHONE=+914000000000
SUPPORT_EMAIL=support@carecompanion.example
SUPPORT_WHATSAPP=
PRIVACY_URL=https://carecompanion.example/privacy
TERMS_URL=https://carecompanion.example/terms
ACCOUNT_DELETION_URL=https://carecompanion.example/account/delete
MIN_APP_VERSION_PATIENT_ANDROID=1.0.0
MIN_APP_VERSION_PATIENT_IOS=1.0.0
MIN_APP_VERSION_PROVIDER_ANDROID=1.0.0
MIN_APP_VERSION_PROVIDER_IOS=1.0.0

# ---------------------------------------------------------------- v1.2 functional completeness (contract sections 29-39)
PUBLIC_API_BASE_URL=http://localhost:4000/api/v1   # absolute base for public URLs (profile photos: <base>/media/<id>)
SCHEDULE_HORIZON_DAYS=14        # bookable days generated ahead from each doctor's weekly schedule
SELLER_LEGAL_NAME=CareCompanion Health Services Pvt. Ltd. (placeholder)   # printed on invoices [REQUIRES TAX REVIEW]
SELLER_GSTIN=                   # optional; "Not applicable" on invoices when empty
SELLER_ADDRESS=Hyderabad, Telangana, India (placeholder address)
HEALTHCARE_GST_RATE=0           # percent applied to invoices (healthcare services generally exempt) [REQUIRES TAX REVIEW]
PLATFORM_FEE_PCT=20             # percent deducted from doctor/provider earnings in settlements
ABDM_ENABLED=false              # ABHA verification returns 503 until the ABDM adapter is certified and connected
MIN_APP_VERSION_DOCTOR_ANDROID=1.0.0
MIN_APP_VERSION_DOCTOR_IOS=1.0.0

# ---------------------------------------------------------------- v1.3 growth & care programs (contract sections 41-62)
# Partner adapters: the mock partner is the default outside production (driven by the worker). Values: see README.
DATA_ENCRYPTION_KEY=            # 32 bytes (hex/base64) for insurance policy numbers; derived from MFA/JWT key when empty
WHATSAPP_PROVIDER=mock          # mock | meta | disabled
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=dev-only-whatsapp-app-secret      # X-Hub-Signature-256 HMAC key
WHATSAPP_VERIFY_TOKEN=dev-only-whatsapp-verify-token  # hub.verify_token for the webhook handshake
WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
WHATSAPP_TEMPLATE_CARE_UPDATE=care_update
WHATSAPP_TEMPLATE_REMINDER=daily_reminder
WHATSAPP_TEMPLATE_ALERT=family_alert
WHATSAPP_TEMPLATE_LANG=en
APP_DEEP_LINK_BASE=https://carecompanion.example/app
LAB_PARTNER=mock                # mock | http | disabled
LAB_PARTNER_NAME=Sample Diagnostics (mock partner)
LAB_PARTNER_BASE_URL=
LAB_PARTNER_API_KEY=
LAB_WEBHOOK_SECRET=dev-only-lab-webhook-secret        # X-Lab-Signature HMAC key
LAB_MOCK_REPORT_MINUTES=2
AMBULANCE_PARTNER=mock          # mock | http | disabled (never replaces 108)
AMBULANCE_PARTNER_NAME=Sample Ambulance Network (mock partner)
AMBULANCE_PARTNER_BASE_URL=
AMBULANCE_PARTNER_API_KEY=
AMBULANCE_MOCK_ASSIGN_SEC=15    # <= 20
ABDM_MODE=mock                  # mock | sandbox | production | disabled
ABDM_BASE_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_HIU_ID=
ABDM_HIP_ID=
ABDM_CALLBACK_URL=
ABDM_WEBHOOK_SECRET=dev-only-abdm-webhook-secret      # X-ABDM-Signature HMAC key (mock/sandbox harness)
ABDM_MOCK_CONSENT_SEC=10
DRUG_KNOWLEDGE_PROVIDER=fixture # fixture (interactions-fixture-0.1) | http (licensed drug database)
DRUG_KNOWLEDGE_BASE_URL=
DRUG_KNOWLEDGE_API_KEY=
STT_PROVIDER=mock               # mock | openai_whisper_compatible | google | disabled
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
IVR_PROVIDER=mock               # mock | exotel | twilio | disabled
IVR_WEBHOOK_SECRET=dev-only-ivr-webhook-secret        # X-IVR-Signature HMAC key (exotel/mock)
IVR_PUBLIC_URL=                 # public base URL used for X-Twilio-Signature validation
SOS_BUTTON_PROVIDER=mock        # mock | vendor | disabled
SOS_WEBHOOK_SECRET=dev-only-sos-webhook-secret        # X-SOS-Signature HMAC key
GOOGLE_MAPS_API_KEY=            # optional: Distance Matrix refines route distances/ETAs
ROUTE_SPEED_KMH=20
INVITE_REWARD_INVITER=100
INVITE_REWARD_INVITEE=100
WALLET_CREDIT_EXPIRY_DAYS=365   # [REQUIRES LEGAL REVIEW: RBI PPI rules]
INVITE_REDEEM_WINDOW_DAYS=7
